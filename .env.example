APP_NAME=Digicardo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (sqlite for zero-config local, mysql/pgsql for production)
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=Digicardo
# DB_USERNAME=root
# DB_PASSWORD=

# Session Management (database for single/multi-server, redis for high throughput)
SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

# Asynchronous Queues & Cache
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=Digicardo_cache_

# Redis Configuration (Optional production queue/cache backend)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Object Storage (AWS S3 / Cloudflare R2 for production media assets)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=Digicardo-media
# AWS_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# AWS_URL=https://media.Digicardo.app
# AWS_USE_PATH_STYLE_ENDPOINT=false

# Email Delivery Configuration (log for local, smtp/resend/ses for production)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@Digicardo.app"
MAIL_FROM_NAME="${APP_NAME}"

# Frontend Same-Origin BFF Integration
FRONTEND_URL=http://localhost:3000
# Production: FRONTEND_URL=https://digicardo.in
# Production: CORS_ALLOWED_ORIGINS=https://digicardo.in,https://www.digicardo.in
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
# Production: SANCTUM_STATEFUL_DOMAINS=digicardo.in,www.digicardo.in

# Analytics Privacy Salt (Must be >=16 chars, rotated periodically in production)
ANALYTICS_DAILY_SALT=change-me-to-a-secure-random-32-byte-hex-string

# Cloudflare Invalidation & Custom Hostnames
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Stripe Billing Provider
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Observability & Error Tracking
OBSERVABILITY_ERROR_TRACKING_DRIVER=null
